# ============================================================
# MyUS University Portal – Root .gitignore
# ============================================================

# ---- OS generated files ----
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Editor / IDE ----
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---- Java / Maven / Gradle ----
target/
build/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.log

# ---- Node / Frontend ----
node_modules/
dist/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Testing ----
coverage/

# ---- Environment / Secrets ----
*.pem
*.key

# ---- Temporary files ----
*.tmp
*.temp
structure.txt
