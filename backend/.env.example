# ============================================================
# MyUS University Portal – Backend Environment Variables
# ============================================================
# Copy this file to a local file and fill in real values.
# The application reads from application.properties which
# has fallback defaults; override them via OS env vars.
# ============================================================

# ----- Database (SQL Server) -----
SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=MyUS;encrypt=false;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=change-me

# ----- JWT -----
# Base64-encoded secret (at least 256 bits for HS256)
JWT_SECRET=change-me-to-a-strong-base64-secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ----- CORS -----
CORS_ALLOWED_ORIGINS=http://localhost:3000
